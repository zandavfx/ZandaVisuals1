# Bezpečnostní hlavičky veřejných formulářů ZandaVisuals OS (předaudit SOC 2 /
# ISO 27001, 1. 10. 2026). Jen pro formuláře — zbytek webu beze změny.
# Skripty CSP neomezuje (stránka formuláře načítá data z app.zandavisuals.com);
# zakazuje jen vložení do cizí stránky (clickjacking) a pluginy.
/formular/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff

/formular-app/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff

# Link-in-bio (1. 10. 2026): stejně jako formuláře — skripty CSP neomezuje (Cloudflare Web Analytics,
# ochrana e-mailu a robotů vkládají vlastní skripty), zakazuje vložení do cizí stránky a pluginy.
/odkazy
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/odkazy/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
